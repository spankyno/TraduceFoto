# ============================================================
# FotoTraductor – Environment variables
# ============================================================
# IMPORTANT: The production Cloudflare Pages deployment does NOT
# use a server-side GEMINI_API_KEY. Every user must supply their
# own key through the Settings (⚙️) panel of the app.
#
# The variable below is kept only for optional local development
# convenience and is IGNORED by the security-hardened endpoints.
# ============================================================

# GEMINI_API_KEY="AIzaSy..."   ← leave empty / do not set in production

# APP_URL is injected automatically by AI Studio / Cloudflare Pages
APP_URL="https://traducefoto.pages.dev"
