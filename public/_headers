# Cabeceras de seguridad para los ficheros estáticos de Cloudflare Pages.
# OJO: este fichero NO se aplica a las respuestas de /api (Functions): esas
# cabeceras se fijan en functions/api/translate-photo.ts.
#
# La CSP completa de la app NO va aquí a propósito: se inyecta como <meta> en
# index.html durante el build (ver vite.config.ts). Motivo: si /* tuviera una
# CSP por cabecera, Cloudflare la sumaría a la de /analytics-frame.html y el
# navegador aplicaría la intersección de ambas, bloqueando el tracker.
# Aquí solo se pone frame-ancestors, que una <meta> no soporta.

/*
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/registerSW.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
